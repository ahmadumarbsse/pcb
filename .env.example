# =======================================================
# PCB CRICKET TICKET BOOKING SYSTEM - CONFIGURATION
# =======================================================

# Application
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME="PCB Official Ticket Portal (Demo)"

# Database (PostgreSQL)
# e.g. postgresql://postgres:postgres@localhost:5432/pcb_ticketing
# If left empty, defaults to local embedded PGlite for development and testing
DATABASE_URL=postgresql://user:password@localhost:5432/pcb_tickets

# Better Auth
BETTER_AUTH_SECRET=your-random-32-character-secret-key-placeholder
BETTER_AUTH_URL=http://localhost:3000

# Redis (Seat Locks & Rate Limiting)
# e.g. redis://localhost:6379
# If omitted, falls back to in-memory lock manager for local development
REDIS_URL=redis://localhost:6379

# Cryptographic QR Code Ticket Signing Secret
# Must be at least 32 characters
TICKET_SIGNING_SECRET=change-this-to-a-secure-random-hmac-key-min-32-chars

# Payment Gateway Adapter Configurations
# Supported adapters: "sandbox" | "jazzcash" | "easypaisa" | "card"
PAYMENT_GATEWAY_PROVIDER=sandbox
PAYMENT_MERCHANT_ID=sandbox_merchant_id
PAYMENT_SECRET_KEY=sandbox_secret_key
PAYMENT_WEBHOOK_SECRET=sandbox_webhook_secret

# Notification Services (Email / SMS)
NOTIFICATION_PROVIDER=mock
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=587
SMTP_USER=smtp_username_placeholder
SMTP_PASS=smtp_password_placeholder
NOTIFICATION_FROM_EMAIL=tickets@pcb-cricket.demo
SMS_API_KEY=sms_provider_api_key_placeholder

# Development Mode
NODE_ENV=development
